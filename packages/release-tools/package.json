{
  "name": "release-tools",
  "version": "1.0.0",
  "description": "Scripts used for release management of the widgets tools packages.",
  "private": true,
  "main": "./createRelease.ts",
  "type": "module",
  "scripts": {
    "release:pwt": "node --experimental-strip-types ./createRelease.ts pwt",
    "release:gw": "node --experimental-strip-types ./createRelease.ts gw",
    "build:release:parser": "peggy -o ./utils/changelog-parser/changelog.js --dts --format es ./utils/changelog-parser/changelog.pegjs",
    "test": "tsc --noEmit"
  },
  "engines": {
    "node": "^22.18.0"
  },
  "devDependencies": {
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.18.0",
    "@types/node-fetch": "2.6.13",
    "peggy": "^5.1.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}

    "include": ["./src"],
    "compilerOptions": {
        "module": "nodenext",
        "lib": ["esnext"],
        "target": "es2022",
        "strict": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,

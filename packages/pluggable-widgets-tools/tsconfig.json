{
    "extends": "./configs/tsconfig.base",
    "include": ["./src"],
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "node10",
        "lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator"],
        "target": "es2022",
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "outDir": "./dist",
        "declaration": true,
        "sourceMap": false,
        "paths": {
            "react-hot-loader/root": ["./configs/hot-typescript.ts"],
            "react-native": ["./node_modules/react-native/types_generated/index.d.ts"]
        }
    }
}

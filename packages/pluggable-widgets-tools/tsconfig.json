{
    "extends": "./configs/tsconfig.base",
    "include": ["./src"],
    "compilerOptions": {
        "module": "commonjs",
        "lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator"],
        "target": "es2022",
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "outDir": "./dist",
        "declaration": true,
        "sourceMap": false
    }
}
